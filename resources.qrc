<RCC>
  <qresource prefix="/qml">
    <file alias="Main.qml">qml/Main.qml</file>
    <file alias="components/AppGrid.qml">qml/components/AppGrid.qml</file>
    <file alias="components/Dock.qml">qml/components/Dock.qml</file>
    <file alias="components/Spotlight.qml">qml/components/Spotlight.qml</file>
  </qresource>
  <qresource prefix="/resources">
    <file alias="images/wallpaper.svg">qml/resources/images/wallpaper.svg</file>
    <file alias="icons/phone.svg">qml/resources/icons/phone.svg</file>
    <file alias="icons/messages.svg">qml/resources/icons/messages.svg</file>
    <file alias="icons/safari.svg">qml/resources/icons/safari.svg</file>
    <file alias="icons/settings.svg">qml/resources/icons/settings.svg</file>
    <file alias="icons/dock1.svg">qml/resources/icons/dock1.svg</file>
    <file alias="icons/dock2.svg">qml/resources/icons/dock2.svg</file>
    <file alias="icons/dock3.svg">qml/resources/icons/dock3.svg</file>
    <file alias="icons/dock4.svg">qml/resources/icons/dock4.svg</file>
  </qresource>
</RCC>
